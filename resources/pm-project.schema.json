{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "directory": {
      "type": "string"
    },
    "idMask": {
      "default": "000",
      "type": "string",
      "pattern": "^0{1,10}$"
    },
    "defaultStatus": {
      "default": "new",
      "type": "string"
    },
    "doneStatuses": {
      "default": [
        "done"
      ],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockedStatuses": {
      "default": [
        "blocked"
      ],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "types": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "tag": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
          },
          "defaultStatus": {
            "type": "string"
          },
          "doneStatuses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blockedStatuses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "guide": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "boolean",
                "const": false
              }
            ]
          }
        },
        "required": [
          "tag"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "directory"
  ],
  "additionalProperties": false
}
